{
	"name": "expo-immigration-app",
	"version": "1.0.0",
	"private": true,
	"main": "expo-router/entry",
	"scripts": {
		"start": "expo start",
		"android": "expo run:android",
		"ios": "expo run:ios",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc --noEmit",
		"test": "vitest",
		"test:once": "vitest run --passWithNoTests",
		"release:config": "node scripts/validate-release-config.mjs",
		"release:remote-check": "node scripts/check-production-readiness.mjs",
		"eas-build-pre-install": "node scripts/validate-release-config.mjs && npx -y hpsetup@4.7.0 native --auto"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.110.0",
		"@better-auth/expo": "~1.6.22",
		"@convex-dev/better-auth": "^0.12.5",
		"@expo-google-fonts/fraunces": "^0.4.1",
		"@expo-google-fonts/inter": "^0.4.2",
		"@expo/metro-runtime": "~57.0.8",
		"@gorhom/bottom-sheet": "^5.2.14",
		"@internationalized/date": "^3.12.0",
		"@internationalized/number": "^3.6.6",
		"@react-native-vector-icons/lucide": "^13.1.2",
		"@shopify/flash-list": "^2.3.2",
		"@shopify/react-native-skia": "2.6.2",
		"@tanstack/react-form": "^1.33.0",
		"better-auth": "~1.6.22",
		"convex": "^1.42.1",
		"convex-helpers": "^0.1.120",
		"expo": "~57.0.10",
		"expo-asset": "~57.0.8",
		"expo-blur": "~57.0.2",
		"expo-clipboard": "~57.0.1",
		"expo-constants": "57.0.9",
		"expo-device": "~57.0.1",
		"expo-document-picker": "~57.0.1",
		"expo-file-system": "~57.0.1",
		"expo-font": "~57.0.1",
		"expo-haptics": "~57.0.1",
		"expo-image": "~57.0.2",
		"expo-linking": "~57.0.5",
		"expo-localization": "~57.0.1",
		"expo-network": "~57.0.1",
		"expo-router": "~57.0.10",
		"expo-secure-store": "~57.0.1",
		"expo-sharing": "~57.0.8",
		"expo-splash-screen": "~57.0.5",
		"expo-status-bar": "~57.0.1",
		"expo-web-browser": "~57.0.2",
		"heroui-native": "^1.0.2",
		"heroui-native-pro": "^1.0.0-beta.5",
		"pdf-lib": "^1.17.1",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"react-native": "0.86.2",
		"react-native-gesture-handler": "~2.32.0",
		"react-native-keyboard-controller": "^1.21.13",
		"react-native-nitro-image": "^0.15.1",
		"react-native-nitro-modules": "^0.36.1",
		"react-native-reanimated": "4.5.1",
		"react-native-safe-area-context": "~5.7.0",
		"react-native-screens": "~4.26.0",
		"react-native-svg": "15.15.4",
		"react-native-worklets": "0.10.1",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.17",
		"uniwind": "^1.5.0",
		"victory-native": "^41.20.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@edge-runtime/vm": "^5.0.0",
		"@resvg/resvg-js": "^2.6.2",
		"@types/react": "~19.2.15",
		"convex-test": "^0.0.54",
		"eslint": "^9.39.4",
		"eslint-config-expo": "~57.0.1",
		"oxfmt": "^0.55.0",
		"typescript": "~6.0.3",
		"vitest": "^4.1.9"
	},
	"overrides": {
		"expo-constants": "57.0.9"
	},
	"expo": {
		"install": {
			"exclude": [
				"@shopify/flash-list",
				"react-native-keyboard-controller"
			]
		},
		"doctor": {
			"reactNativeDirectoryCheck": {
				"exclude": [
					"@react-native-vector-icons/lucide",
					"react-native-nitro-image"
				]
			}
		}
	},
	"trustedDependencies": [
		"heroui-pro",
		"@heroui-pro/react",
		"heroui-native-pro"
	]
