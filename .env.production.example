# EAS production environment (replace every placeholder)
EXPO_PUBLIC_CONVEX_URL=https://enduring-toucan-31.convex.cloud
EXPO_PUBLIC_CONVEX_SITE_URL=https://enduring-toucan-31.convex.site
EXPO_PUBLIC_AUTH_SITE_URL=https://auth.immifile.app
EXPO_PUBLIC_PRIVACY_URL=https://jaxsonb04.github.io/expo-immigration-app/privacy/
EXPO_PUBLIC_SUPPORT_URL=https://jaxsonb04.github.io/expo-immigration-app/support/
EXPO_PUBLIC_SUPPORT_EMAIL=REQUIRED@example.com
EXPO_PUBLIC_PASSWORD_RECOVERY_ENABLED=true
IMMIFILE_PRODUCTION_BACKEND_CONFIRMED=true
IMMIFILE_AUTH_EMAIL_CONFIRMED=true

# EAS secret — trusted hpsetup API key beginning with hp_
HEROUI_KEY=hp_REQUIRED_SECRET

# Convex production environment — do not put real values in this file
BETTER_AUTH_SECRET=REQUIRED_32_PLUS_CHARACTER_SECRET
BETTER_AUTH_URL=https://auth.immifile.app
AUTH_EMAIL_WEBHOOK_URL=https://REQUIRED.example/auth-email
AUTH_EMAIL_WEBHOOK_TOKEN=REQUIRED_SECRET
AUTH_EMAIL_FROM=Immifile Support <REQUIRED@example.com>
DEV_SEED_ENABLED=false
